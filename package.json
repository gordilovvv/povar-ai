{
  "name": "sema-ai",
  "version": "0.0.20",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "imports": {
    "#*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env.dev src/Webhook.ts",
    "dev:worker": "tsx watch --conditions=development --env-file=.env.dev src/Worker.ts",
    "build": "tsc && cp -R src/Intelligence/Prompts dist/Intelligence/Prompts",
    "prod": "node --env-file=.env.prod dist/Webhook.js",
    "prod:worker": "node --env-file=.env.prod dist/Worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "pgweb": "pgweb --url $(grep DATABASE_URL .env.dev | cut -d= -f2-) --listen 8082"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@whatwg-node/server": "^0.11.0",
    "cyrillic-to-translit-js": "^3.2.1",
    "dayjs": "^1.11.21",
    "itty-router": "^5.0.22",
    "libphonenumber-js": "^1.13.9",
    "pg": "^8.16.3",
    "pg-format": "^1.0.4",
    "pino": "^9.9.5",
    "pino-pretty": "^13.1.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.6",
    "@types/pg-format": "^1.0.5",
    "chrome-devtools-mcp": "^1.6.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
